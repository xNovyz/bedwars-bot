# Rinomina questo file in ".env" e compila i valori

# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=il_tuo_token_qui

# Application ID (Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=id_applicazione_qui

# ID del tuo server Discord (tasto destro sul server -> Copia ID server)
# Serve solo per registrare i comandi istantaneamente su quel server durante i test
GUILD_ID=id_server_qui
